{
  "id": "dir",
  "version": "1.0.0",
  "name": "Dir 目录列表",
  "description": "列出指定目录的内容（Windows 用 dir，Linux/macOS 用 ls -l）",
  "type": "external",
  "executable": "dir",
  "parameters": [
    {
      "name": "path",
      "label": "目录路径",
      "type": "text",
      "required": false
    },
    {
      "name": "showHidden",
      "label": "显示隐藏文件",
      "type": "checkbox",
      "required": false
    },
    {
      "name": "sortByTime",
      "label": "按时间排序",
      "type": "checkbox",
      "required": false
    }
  ]
}